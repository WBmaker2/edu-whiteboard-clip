{
  "name": "edu-whiteboard-clip",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview",
    "qa:smoke": "node scripts/qa-smoke.mjs",
    "qa:ai": "node scripts/qa-ai-mock.mjs",
    "qa:v2": "node scripts/qa-v2.mjs",
    "qa:mp4": "node scripts/qa-mp4.mjs",
    "qa:layouts": "node scripts/qa-layouts.mjs",
    "qa:pixel": "node scripts/qa-pixel.mjs",
    "qa:a11y": "node scripts/qa-a11y.mjs",
    "qa:media": "node scripts/qa-media.mjs",
    "qa:all": "npm run qa:smoke && npm run qa:v2 && npm run qa:ai && npm run qa:media && npm run qa:a11y && npm run qa:pwa",
    "qa:pwa": "node scripts/qa-pwa.mjs",
    "qa:share": "node scripts/qa-share.mjs",
    "qa:quiz": "node scripts/qa-quiz.mjs",
    "qa:3d": "node minimax-m31-test/scripts/shot.mjs zoo && node minimax-m31-test/scripts/shot.mjs molecule && node minimax-m31-test/scripts/shot.mjs defense && node minimax-m31-test/scripts/shot.mjs landing",
    "qa:ffmpeg": "node scripts/qa-ffmpeg.mjs",
    "qa:3d:cards": "node minimax-m31-test/scripts/card-shots.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "fix-webm-duration": "^1.0.6",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.2.2",
    "katex": "^0.19.0",
    "lucide": "^0.468.0",
    "lucide-react": "^0.468.0",
    "lz-string": "^1.5.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/katex": "^0.16.8",
    "@types/lz-string": "^1.3.34",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.55.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
